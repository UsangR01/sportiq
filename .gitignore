keys.docx
~$keys.docx
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Session-local Claude Code settings
.claude/settings.local.json

# ML: generated/regeneratable — real source is ml/training/*.py, ml/notebooks/, ml/evaluation/
ml/data/
ml/mlruns/

# ml/artifacts holds every training run ever (27MB, mostly superseded), EXCEPT deployed/, which
# holds only what models_registry marks active (~2.6MB) and must ship inside the image — a
# container built from a clean clone would otherwise resolve a perfectly portable filename to
# nothing. Staged by backend/scripts/stage_artefacts.py.
#
# Note the contents are excluded (ml/artifacts/*), not the directory (ml/artifacts/). Git does
# not descend into an excluded DIRECTORY, so a later negation inside one never matches and the
# exception silently does nothing.
ml/artifacts/*
!ml/artifacts/deployed/

# Celery beat's local persisted schedule (shelve DB tracking each periodic task's last-run
# time) — dev-machine-local state, not something to share/commit.
backend/celerybeat-schedule*

feature_engineering.ipynb

# Local agent state — settings.local.json was already ignored, but the lock file and any
# future local-only files under here shouldn't reach a public repo either.
.claude/

# Third-party API documentation kept locally for reference (14MB of vendor PDFs). Freely
# available online, so not worth permanent history in a public repo — same call already made
# for balldontlie_api_documentation.pdf.
pdf-documents/

# Editor/office backup artefacts
*.docx.bak
~$*.docx

# Exported training data for the standalone notebook — 8.6MB of derived parquet, regenerable
# with ml/export_for_notebook.py. Same reasoning as ml/data/ above: the script and the
# notebook are source and belong in history; the data they produce does not.
ml/export/*.parquet

# Jupyter editor state
.ipynb_checkpoints/

# Firebase SERVICE ACCOUNT keys — full admin access to the Firebase project. These must never
# reach a public repo. Upload to Expo via `eas credentials` (FCM V1) and delete the local copy.
# NOTE: mobile/google-services.json is a different thing and is NOT ignored — it ships inside
# the APK by design, so it cannot be a secret, and EAS Build needs it present to build.
**/*-firebase-adminsdk-*.json
**/serviceAccountKey*.json
**/firebase-service-account*.json

# Per-fixture test outputs written by ml/training/train_football.py, one file per training run.
# Generated and regeneratable, same reasoning as ml/data/ and ml/export/*.parquet above — the
# code that produces them is the source. They also travel with their MLflow run as an artifact.
ml/evaluation/*.parquet
