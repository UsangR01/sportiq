keys.docx
~$keys.docx
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Session-local Claude Code settings
.claude/settings.local.json

# ML: generated/regeneratable — real source is ml/training/*.py, ml/notebooks/, ml/evaluation/
ml/data/
ml/artifacts/
ml/mlruns/

# Celery beat's local persisted schedule (shelve DB tracking each periodic task's last-run
# time) — dev-machine-local state, not something to share/commit.
backend/celerybeat-schedule*

feature_engineering.ipynb

# Local agent state — settings.local.json was already ignored, but the lock file and any
# future local-only files under here shouldn't reach a public repo either.
.claude/

# Third-party API documentation kept locally for reference (14MB of vendor PDFs). Freely
# available online, so not worth permanent history in a public repo — same call already made
# for balldontlie_api_documentation.pdf.
pdf-documents/

# Editor/office backup artefacts
*.docx.bak
~$*.docx
