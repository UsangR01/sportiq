# Copy to .env and fill in real values locally (never commit .env).
# Real values for this project currently live in keys.docx at the repo root — see CLAUDE.md.

# 127.0.0.1, NOT localhost — this is deliberate and was a real, hard-to-diagnose outage.
# On Windows, "localhost" resolves to IPv6 ::1 first, while Docker Desktop's port proxy binds
# IPv4 only. Every new connection from host to container is then refused. It does not fail
# cleanly: symptoms were 61 pytest errors, API 500s, and failed data exports, none of which
# point at DNS. Confirmed with a raw Postgres SSLRequest — 127.0.0.1 replied, localhost reset
# the connection. Pinning the literal IPv4 address sidesteps resolution order entirely.
DATABASE_URL=postgresql+asyncpg://sportiq_user:password@127.0.0.1:5432/sportiq
REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Data source adapters (TDD §2.2)
THERUNDOWN_API_KEY=
API_FOOTBALL_KEY=
BALLDONTLIE_API_KEY=
ROTOWIRE_API_KEY=
HIGHLIGHTLY_API_KEY=

# Push notifications
EXPO_ACCESS_TOKEN=

# CORS — comma-separated list of allowed frontend origins. 8081 is Expo web's dev server
# default (mobile/, `expo start --web`); 19006 is the older Expo CLI's default.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

SENTRY_DSN_BACKEND=

# Where trained model artefacts (.joblib) live. models_registry stores a FILENAME, so the same
# registry row works locally and in a container — model promotion stays a DB update, not a
# redeploy. Empty = the repo's own ml/artifacts, which is what local dev wants. A deployment
# sets this to wherever artefacts are mounted or baked into the image.
MODELS_DIR=
THESTATSAPI_KEY=
