# Copy to .env and fill in real values locally (never commit .env).
# Real values for this project currently live in keys.docx at the repo root — see CLAUDE.md.

DATABASE_URL=postgresql+asyncpg://sportiq_user:password@localhost:5432/sportiq
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Data source adapters (TDD §2.2)
THERUNDOWN_API_KEY=
API_FOOTBALL_KEY=
BALLDONTLIE_API_KEY=
ROTOWIRE_API_KEY=
HIGHLIGHTLY_API_KEY=

# Push notifications
EXPO_ACCESS_TOKEN=

# CORS — comma-separated list of allowed frontend origins. 8081 is Expo web's dev server
# default (mobile/, `expo start --web`); 19006 is the older Expo CLI's default.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

SENTRY_DSN_BACKEND=
